# LetShare 服务器环境变量配置
# 复制此文件为 .env 并修改相应的配置（.env 已被 git 忽略，勿提交真实值）

# 服务器认证密钥 - 用于生成和验证authtoken
# 请修改为你自己的密钥，并保持与前端配置一致
SERVER_AUTH_SECRET=sever_auth_123

# 服务器运行模式 (local/production)
MODE=local

# 服务器端口
LETSHARE_SERVER_PORT=8080

# TLS配置
LETSHARE_TLS_ENABLED=false
LETSHARE_TLS_CERT_FILE=/path/to/cert.pem
LETSHARE_TLS_KEY_FILE=/path/to/key.pem
LETSHARE_TLS_DOMAIN=your-domain.com

# 日志级别 (debug/info/warn/error)
LETSHARE_LOG_LEVEL=info

# WebSocket配置
LETSHARE_WEBSOCKET_MAX_ROOM_USERS=50

# 文件传输配置
# LETSHARE_FILE_TRANSFER_MAX_FILE_SIZE=3221225472      # 最大文件大小(bytes),默认3GB PRO上限

# 会议纪要 AI：文本模型固定 Gemini（OpenAI 兼容网关），不再支持 GLM
# 密钥只放在服务器环境，绝不发给客户端
MEETING_AI_BASE_URL=https://api.fullive.xyz/v1
MEETING_AI_MODEL=gemini-3.5-flash-lite
MEETING_AI_API_KEY=
# 显式关闭会议纪要 AI（默认：配置了 key 即启用）
MEETING_AI_ENABLED=true
# 运营者声明：该 key 在服务商侧不会产生计费（仅为声明，服务商侧仍需自行保证）
MEETING_AI_BILLING_DISABLED=true

# Somni ASR 服务（服务端登录并连接上游 WebSocket）
MEETING_ASR_STREAM_HTTP_BASE=
MEETING_ASR_STREAM_WS_BASE=
MEETING_ASR_STREAM_EMAIL=
MEETING_ASR_STREAM_PASSWORD=
MEETING_ASR_STREAM_LOGIN_TYPE=password
MEETING_ASR_STREAM_DEVICE_PLATFORM=android
MEETING_ASR_STREAM_DEVICE_NAME=letshare-server
MEETING_ASR_STREAM_APP_VERSION=1.0.0
MEETING_ASR_STREAM_TIMEZONE=Asia/Shanghai

# AI minutes starts only when both Gemini and Somni are configured and ready.
# The server mixes every current and late-joining publisher; the notice is not
# an audio gate. Server-side energy VAD suppresses silence before Somni ASR.
# Caption-only sessions may still use their separate consent behavior.
