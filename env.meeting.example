# AI meeting minutes: server-mixed ASR + a server-side text model.
# LLM is uniformly Gemini (OpenAI-compatible gateway); ASR is uniformly the
# configured Somni recognition service. GLM is no longer supported.
# Copy the needed keys into the server environment; never commit real values.

# Text model: fixed Gemini flash-lite through an OpenAI-compatible gateway.
MEETING_AI_BASE_URL=https://api.fullive.xyz/v1
MEETING_AI_MODEL=gemini-3.5-flash-lite
MEETING_AI_API_KEY=

# Explicit switch: false hard-disables summaries; when unset, a configured
# key enables them.
MEETING_AI_ENABLED=true
# Operator attestation only; provider-side billing controls still apply.
MEETING_AI_BILLING_DISABLED=true

# ASR: Somni. The server logs in over HTTP and holds the upstream
# WebSocket sessions used by the live meeting pipeline and legacy clients.
MEETING_ASR_STREAM_HTTP_BASE=
MEETING_ASR_STREAM_WS_BASE=
MEETING_ASR_STREAM_EMAIL=
MEETING_ASR_STREAM_PASSWORD=
MEETING_ASR_STREAM_LOGIN_TYPE=password
MEETING_ASR_STREAM_DEVICE_PLATFORM=android
MEETING_ASR_STREAM_DEVICE_NAME=letshare-server
MEETING_ASR_STREAM_APP_VERSION=1.0.0
MEETING_ASR_STREAM_TIMEZONE=Asia/Shanghai

# AI minutes start only when both Gemini and Somni are configured and ready.
# All current and late-joining meeting publishers are mixed server-side; the
# minutes notice does not gate audio. Energy VAD suppresses silence before ASR.
# The older chunk and stream request shapes remain compatibility inputs only.
